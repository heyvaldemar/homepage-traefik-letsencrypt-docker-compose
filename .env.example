# Homepage + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# HOMEPAGE_IMAGE_TAG=ghcr.io/gethomepage/homepage:v2.3.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.homepage.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Homepage
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname. Must resolve to this server's public IP for the
# Let's Encrypt TLS-ALPN challenge. REQUIRED.
HOMEPAGE_HOSTNAME=home.example.com

# The host-validation allow-list, required since Homepage v1.0 and the single
# most common reason a fresh install answers "host validation failed" instead
# of rendering. It defaults to HOMEPAGE_HOSTNAME, which is right when you reach
# Homepage on 443.
#
# Set it explicitly when anything serves on another port: the value is compared
# against the Host HEADER, which carries the port whenever the port is not the
# scheme's default. `home.example.com:8443`, not `home.example.com`.
#
# Worth knowing how this fails, because it is not obvious: the container stays
# HEALTHY the whole time. Its probe talks to 127.0.0.1:3000 and never sends a
# Host header, so everything looks fine while every real request gets a 400.
# HOMEPAGE_ALLOWED_HOSTS=home.example.com

# Where your configuration lives on this host. Seeded once from config.example/
# and then yours — it is gitignored, so `git pull` never collides with your
# edits and `update.sh` (which refuses to run over local changes) keeps working.
# HOMEPAGE_CONFIG_PATH=./config

# Timezone used for the clock widget and for timestamps.
# HOMEPAGE_TZ=Etc/UTC

# How long Traefik will hold a request or response open. Homepage's widgets fan
# out to whatever you point them at, and a slow backend behind one of them
# should not become a failed dashboard.
# HOMEPAGE_READ_TIMEOUT=0s
# HOMEPAGE_WRITE_TIMEOUT=0s
# HOMEPAGE_IDLE_TIMEOUT=600s
# Every Traefik template in this fleet also takes TRAEFIK_READ_TIMEOUT,
# TRAEFIK_WRITE_TIMEOUT and TRAEFIK_IDLE_TIMEOUT. When set they win over
# the names above, which keep working.

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────
#
# The archive covers the config directory, which is the entire application
# state: Homepage has no database. Everything it knows is the YAML you wrote.

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# DATA_BACKUP_PRUNE_DAYS=7
# DATA_BACKUPS_PATH=/srv/homepage-config/backups
# DATA_PATH=/config
# DATA_BACKUP_NAME=homepage-config-backup

# Resource limits (defaults shown). What moves these is the number of widgets
# polling backends, not the number of links on the page.
# HOMEPAGE_MEMORY_LIMIT=512m
# HOMEPAGE_CPU_LIMIT=1.0
# HOMEPAGE_MEMORY_RESERVATION=64m
# HOMEPAGE_CPU_RESERVATION=0.1
# HOMEPAGE_DOCKERPROXY_MEMORY_LIMIT=64m
# HOMEPAGE_DOCKERPROXY_CPU_LIMIT=0.5
# HOMEPAGE_DOCKERPROXY_MEMORY_RESERVATION=16m
# HOMEPAGE_DOCKERPROXY_CPU_RESERVATION=0.1
# HOMEPAGE_INIT_MEMORY_LIMIT=64m
# HOMEPAGE_INIT_CPU_LIMIT=0.5
# HOMEPAGE_INIT_MEMORY_RESERVATION=8m
# HOMEPAGE_INIT_CPU_RESERVATION=0.1
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# HOMEPAGE_BACKUPS_MEMORY_LIMIT=256m
# HOMEPAGE_BACKUPS_CPU_LIMIT=0.5
# HOMEPAGE_BACKUPS_MEMORY_RESERVATION=16m
# HOMEPAGE_BACKUPS_CPU_RESERVATION=0.1

# How long docker waits before SIGKILL. Homepage holds no database, so this is
# shorter than the fleet's usual sixty seconds.
# HOMEPAGE_STOP_GRACE_PERIOD=30s

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image while every other pin stays as tested. Needs Docker
# Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# HOMEPAGE_IMAGE_VERSION=v2.3.0
# HOMEPAGE_DOCKERPROXY_IMAGE_VERSION=v0.5.0
# HOMEPAGE_BACKUPS_IMAGE_VERSION=3.22
